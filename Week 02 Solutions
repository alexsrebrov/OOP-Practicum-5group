#include<iostream>
#include<fstream>

const int MAX_SIZE=1024;

class Student {
public:
    char name[MAX_SIZE];
    char fn[MAX_SIZE];
    char password[MAX_SIZE];

    void addStudent(Student& s) {
        std::cin.getline(s.name,MAX_SIZE);
        std::cin.getline(s.fn,MAX_SIZE);
        std::cin.getline(s.password,MAX_SIZE);
    }

    void printStudent(Student& s) {
        std::cout<<s.name<<std::endl;
        std::cout<<s.fn<<std::endl;
        std::cout<<s.password<<std::endl;
    }
};

class StudentSerializer {
public:
    void writeToFile(Student& s,std::ofstream& file) {
        file << s.name << std::endl;
        file << s.fn <<std::endl;
        file << s.password<<std::endl;
    }

    void readFromFile(Student& s,std::ifstream& file) {
        file.getline(s.name,MAX_SIZE);
        file.getline(s.fn,MAX_SIZE);
        file.getline(s.password,MAX_SIZE);
    }

    void save(Student& s,const char* fileName) {
        std::ofstream file(fileName);
        if (!file.is_open()) {
            return;
        }
        writeToFile(s,file);
        file.close();
    }

    void read(Student& s,const char* fileName) {
        std::ifstream file(fileName);
        if (!file.is_open()) {
            return;
        }
        readFromFile(s,file);
        file.close();
    }
};

int main() {
  Student student,loaded;
  student.addStudent(student);
  student.printStudent(student);
  StudentSerializer ss;
  ss.save(student,"student_info.txt");
  ss.read(loaded,"student_info.txt");
  loaded.printStudent(loaded);
}
